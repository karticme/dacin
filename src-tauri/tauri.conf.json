{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dacin",
  "version": "0.1.0",
  "identifier": "com.karticme.dacin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:4000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 860,
        "height": 540,
        "minWidth": 860,
        "minHeight": 540,
        "devtools": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 12,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
